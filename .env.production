# Application
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://pawgo.app

# Database
DATABASE_URL=postgresql://pawgo_user:CHANGE_ME@postgres:5432/pawgo_prod?schema=public

# JWT — use strong random secrets (min 64 chars)
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS_PRODUCTION
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS_PRODUCTION
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_AVATAR_FOLDER=pawgo/avatars

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME
EMAIL_FROM="PawGo" <noreply@pawgo.app>
