# Application
NODE_ENV=staging
PORT=3000
FRONTEND_URL=https://staging.pawgo.app

# Database
DATABASE_URL=postgresql://pawgo_user:pawgo_password@postgres:5432/pawgo_staging?schema=public

# JWT
JWT_ACCESS_SECRET=staging_access_secret_change_this_min_32_chars_xxxx
JWT_REFRESH_SECRET=staging_refresh_secret_change_this_min_32_chars_xxxx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
